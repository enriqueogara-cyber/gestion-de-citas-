# --- Base de datos ---
DATABASE_URL="file:./dev.db"

# --- Servidor ---
PORT=3000

# --- WhatsApp Cloud API (Meta) ---
# Panel: https://developers.facebook.com/apps -> tu App -> WhatsApp -> API Setup
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="cambia-esto-por-un-secreto"
# ID de tu cuenta de WhatsApp Business (WABA), necesario para gestionar plantillas
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# --- Modelo IA (vía OpenRouter, https://openrouter.ai) ---
# Un solo API key, pago con tarjeta normal (sin IBAN ni datos de empresa),
# y puedes elegir modelo (Claude, GPT, Gemini, gratis, etc.) sin tocar código.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"

# --- Google Calendar ---
# Cuenta de servicio con acceso al calendario del centro (compartir el calendario
# con el email de la cuenta de servicio, con permiso "Realizar cambios en eventos").
GOOGLE_SERVICE_ACCOUNT_JSON_PATH="./google-service-account.json"
GOOGLE_CALENDAR_ID="primary"

# --- Configuración del centro ---
# Estos 5 valores son solo la SEMILLA inicial: la primera vez que arranca el
# servidor se copian a la tabla `Clinic` en base de datos, y a partir de ahí
# se editan en caliente desde /simulator/settings (sin tocar .env ni
# reiniciar). Sin CLINIC_LOGO_URL se genera un avatar con las iniciales.
CLINIC_NAME="Clínica Ejemplo"
CLINIC_TIMEZONE="Europe/Madrid"
CLINIC_BRAND_COLOR="#0f766e"
CLINIC_LOGO_URL=""
CLINIC_TAGLINE="Asistente virtual de citas"

# Acceso del equipo: se usa solo para crear el primer administrador.
# En producción son obligatorios; después elimina ADMIN_PASSWORD del entorno.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
WHATSAPP_APP_SECRET=""
# Directorio protegido para copias SQLite (cada día a las 03:00).
BACKUP_DIR="./backups"
